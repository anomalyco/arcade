{
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "../../../node_modules/.cache/tsc/kit-server.tsbuildinfo",
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true
  },
  "include": ["*.ts", "../net/room-core.ts"],
  "exclude": ["workers-shim.d.ts"]
}
