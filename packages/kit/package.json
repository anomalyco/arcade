{
  "name": "@arcade/kit",
  "private": true,
  "type": "module",
  "exports": {
    "./audio": "./audio/index.ts",
    "./textures": "./textures/index.ts",
    "./weather": "./weather/index.ts",
    "./shell": "./shell/index.ts",
    "./*.css": "./*.css",
    "./*": "./*.ts"
  },
  "scripts": {
    "typecheck": "bun ../../scripts/typecheck.ts && bun ../../scripts/typecheck.ts -p server/tsconfig.json",
    "test": "bun test",
    "test:soak": "bun ../../scripts/kit-soak.ts",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "meshoptimizer": "^1.0.1",
    "@arcade/knobs": "workspace:*",
    "@fontsource/barlow-condensed": "^5.3.0"
  },
  "devDependencies": {
    "wgpu-matrix": "^3.4.2",
    "@types/bun": "^1.4.2",
    "@webgpu/types": "^0.1.74",
    "typescript": "7.1.0-beta",
    "vite": "^8.3.4",
    "@cloudflare/workers-types": "^5.20261011.1"
  }
}
