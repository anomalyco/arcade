{
  "name": "getaway",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:client": "vite --host 0.0.0.0 --port 5190 --strictPort",
    "dev:server": "wrangler dev --port 8787",
    "build": "vite build",
    "test": "bun test",
