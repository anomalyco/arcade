{
  "name": "wings",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:worker": "wrangler dev --port 8787",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "build": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260517.0",
    "@types/three": "^0.185.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wrangler": "^4.98.0"
  }
}
