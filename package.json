{
  "name": "arcade",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "bin": {
    "arcade": "./scripts/arcade.ts"
  },
  "workspaces": ["games/getaway", "games/blackout", "games/outbreak", "games/carrier", "games/lab", "games/brawl", "games/archers", "games/walkers", "games/lot", "games/nightshift", "games/barbara", "packages/*"],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "arcade": "bun scripts/arcade.ts",
    "agent-ops": "bun scripts/agent-ops.ts",
    "check:packages": "bun run --filter '@arcade/*' check",
    "check:scripts": "bun games/blackout/scripts/build-id.ts && bun games/outbreak/scripts/build-id.ts && tsc --noEmit -p scripts/tsconfig.json",
    "verify": "bun scripts/verify.ts",
    "verify:remote": "bun scripts/verify-remote.ts",
    "verify:release": "bun scripts/verify.ts --release"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@webgpu/types": "^0.1.74",
    "vite": "^8.3.4",
    "playwright-core": "^1.64.0",
    "typescript": "^5.9.3"
  }
}
