{
  "name": "@arcade/barbara",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/build-id.ts && vite",
    "build": "bun scripts/build-id.ts && vite build",
    "test": "bun scripts/build-id.ts && bun test",
    "typecheck": "bun ../../scripts/typecheck.ts",
    "typecheck:server": "bun ../../scripts/typecheck.ts -p tsconfig.server.json",
    "check": "bun scripts/build-id.ts && bun run typecheck && bun run typecheck:server && bun test && vite build",
    "dev:server": "bun scripts/build-id.ts && vite build && wrangler dev --ip 127.0.0.1 --port 5298"
  },
  "dependencies": {
    "@arcade/kit": "workspace:*"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.74",
    "@types/bun": "^1.4.2",
    "playwright-core": "^1.64.0",
    "typescript": "7.1.0-beta",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0",
    "@cloudflare/workers-types": "^5.20261011.1"
  }
}
