{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "arcade-outbreak",
  "main": "server/index.ts",
  "compatibility_date": "2026-09-08",
  "account_id": "15d29c8639fd3733b1b5486a2acfd968",
  "workers_dev": false,
  "routes": [
    { "pattern": "anoma.ly/arcade/outbreak", "zone_name": "anoma.ly" },
    { "pattern": "anoma.ly/arcade/outbreak/*", "zone_name": "anoma.ly" }
  ],
  "assets": {
    "directory": "./dist", "binding": "ASSETS", "html_handling": "auto-trailing-slash",
    "not_found_handling": "none", "run_worker_first": ["/arcade/outbreak/api/*", "/arcade/outbreak/ws/*", "/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "OutbreakRoom" }, { "name": "LOBBY", "class_name": "Lobby" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OutbreakRoom"] }, { "tag": "v2", "new_sqlite_classes": ["Lobby"] }]
}
