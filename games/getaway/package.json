{
  "name": "getaway",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:client": "vite --host 0.0.0.0 --port 5190 --strictPort",
    "dev:server": "wrangler dev --port 8787",
    "build": "vite build",
    "test": "bun test --parallel --timeout=20000 . ../../packages/kit",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.scripts.json",
    "check": "tsc --noEmit && bun run typecheck:server && bun run test && vite build",
    "compare": "bun scripts/compare.ts",
    "deploy": "rm -rf dist && vite build && wrangler deploy"
  },
  "dependencies": {
    "@arcade/kit": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@types/bun": "^1.4.2",
    "@webgpu/types": "^0.1.74",
    "playwright-core": "^1.64.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "wgpu-matrix": "^3.4.0",
    "wrangler": "^4.149.0"
  }
}
