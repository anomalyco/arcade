{
  "name": "carrier",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:client": "vite --host 0.0.0.0 --port 5197 --strictPort",
    "dev:server": "wrangler dev --port 8797",
    "build": "bun scripts/build-id.ts && vite build",
    "test": "bun scripts/build-id.ts && bun test",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.scripts.json",
    "build:id": "bun scripts/build-id.ts",
    "check": "bun scripts/build-id.ts && tsc --noEmit && bun run typecheck:server && bun test && vite build",
    "shot": "bun scripts/shot.ts",
    "deploy": "bun scripts/build-id.ts && rm -rf dist && vite build && wrangler deploy"
  },
  "dependencies": {
    "@arcade/kit": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@types/bun": "^1.4.2",
    "@webgpu/types": "^0.1.74",
    "playwright-core": "^1.64.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "wgpu-matrix": "^3.4.2",
    "wrangler": "^4.149.0"
  }
}
