{
  "name": "walkers",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "train": "bun scripts/train.ts",
    "check": "tsc --noEmit && bun run typecheck:server && bun run test && vite build",
    "deploy": "rm -rf dist && vite build && wrangler deploy"
  },
  "dependencies": {
    "@arcade/kit": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@types/bun": "^1.4.2",
    "@webgpu/types": "^0.1.74",
    "playwright-core": "^1.64.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  }
}
