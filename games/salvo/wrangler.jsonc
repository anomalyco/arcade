{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arcade-salvo",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-09-08",
  "account_id": "15d29c8639fd3733b1b5486a2acfd968",
  "workers_dev": false,
  "routes": [
    { "pattern": "anoma.ly/arcade/salvo", "zone_name": "anoma.ly" },
    { "pattern": "anoma.ly/arcade/salvo/*", "zone_name": "anoma.ly" }
  ],
  // The build is nested under arcade/salvo so asset paths match the public URL.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/arcade/salvo/ws*", "/arcade/salvo/api/*", "/arcade/salvo/r/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true }
}
