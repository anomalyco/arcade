+        import trellis2.models as tmodels
+
+        init_calls: list[str] = []
+
+        class DummyBase(torch.nn.Module):
+            def initialize_weights(self):
+                init_calls.append("base_init")
+
+        class DummyModel(DummyBase):
+            def __init__(self, dim: int = 4):
+                super().__init__()
+                self.fc = torch.nn.Linear(dim, dim)
+                self.initialize_weights()
+
+        tmodels.DummyModel = DummyModel  # type: ignore[attr-defined]
+        with tempfile.TemporaryDirectory() as tmp:
+            ckpt = os.path.join(tmp, "dummy")
+            with open(f"{ckpt}.json", "w") as f:
+                json.dump({"name": "DummyModel", "args": {"dim": 4}}, f)
+            w = torch.arange(16, dtype=torch.float32).reshape(4, 4)
+            b = torch.ones(4, dtype=torch.float32)
+            save_file({"fc.weight": w, "fc.bias": b}, f"{ckpt}.safetensors")
+
+            m = tmodels.from_pretrained(ckpt)
+            self.assertEqual(init_calls, [])
+            self.assertTrue(torch.equal(m.fc.weight, w))
+            self.assertTrue(torch.equal(m.fc.bias, b))
+
+            # Direct instantiation after from_pretrained must still run initialize_weights
+            _ = DummyModel(4)
+            self.assertEqual(init_calls, ["base_init"])
