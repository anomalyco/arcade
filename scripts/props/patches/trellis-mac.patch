+class TestResidentWorkerLifecycle(unittest.TestCase):
+    def test_fifo_order_error_isolation_and_idle_unload(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            sock_path = os.path.join(tmp, "worker.sock")
+            exit_events: list[str] = []
+            execution_order: list[str] = []
+
+            srv = trellis_worker.TrellisResidentServer(
+                socket_path=sock_path,
+                idle_timeout=0.25,
+                on_exit=lambda: exit_events.append("exited"),
+            )
+            srv.pipeline = object()  # Pre-populated mock pipeline so load_pipeline is a no-op
+
+            def mock_execute(job: dict) -> dict:
+                jid = job["id"]
+                execution_order.append(jid)
+                time.sleep(float(job.get("sleep_s", 0.05)))
+                if job.get("fail"):
+                    raise RuntimeError(f"boom:{jid}")
+                srv.jobs_completed += 1
+                return {"ok": True, "id": jid, "seen_env": os.environ.get("TEST_STAGE1_FLAG")}
+
+            srv._execute_job = mock_execute  # type: ignore[method-assign]
+
+            server_thread = threading.Thread(target=srv.serve_forever, daemon=True)
+            server_thread.start()
+
+            # Wait for socket to bind
+            t0 = time.time()
+            while not os.path.exists(sock_path) and time.time() - t0 < 2.0:
+                time.sleep(0.01)
+            self.assertTrue(os.path.exists(sock_path))
+
+            info = trellis_worker.ping_worker(sock_path)
+            self.assertIsNotNone(info)
+            self.assertTrue(info["ok"])
+
+            # Submit 3 jobs concurrently in staggered order; verify FIFO execution & error isolation
+            results: dict[str, dict] = {}
+
+            def submit(req: dict):
+                results[req["id"]] = trellis_worker.send_request(req, socket_path=sock_path, timeout=5.0)
+
+            t1 = threading.Thread(target=submit, args=({"cmd": "job", "id": "first", "sleep_s": 0.12},))
+            t2 = threading.Thread(target=submit, args=({"cmd": "job", "id": "second-fail", "sleep_s": 0.02, "fail": True},))
+            t3 = threading.Thread(target=submit, args=({"cmd": "job", "id": "third", "sleep_s": 0.02},))
+            t1.start()
+            time.sleep(0.02)
+            t2.start()
+            time.sleep(0.02)
+            t3.start()
+            t1.join()
+            t2.join()
+            t3.join()
+
+            self.assertEqual(execution_order, ["first", "second-fail", "third"])
+            self.assertTrue(results["first"]["ok"])
+            self.assertFalse(results["second-fail"]["ok"])
+            self.assertIn("boom:second-fail", results["second-fail"]["error"])
+            self.assertTrue(results["third"]["ok"])
+
+            # Wait for automatic idle unload (idle_timeout=0.25s)
+            server_thread.join(timeout=2.0)
+            self.assertFalse(server_thread.is_alive())
+            self.assertEqual(exit_events, ["exited"])
+            self.assertFalse(os.path.exists(sock_path))
+
+
+class TestExteriorPruneAndScore(unittest.TestCase):
+    def test_prunes_hollow_interior_cavity(self):
+        from trellis2.pipelines.trellis2_image_to_3d import Trellis2ImageTo3DPipeline
+
+        # Create a 64^3 cube shell with an enclosed hollow cavity inside
+        occ = torch.zeros((1, 1, 64, 64, 64), dtype=torch.float32)
+        occ[:, :, 16:48, 16:48, 16:48] = 1.0
+        occ[:, :, 26:38, 26:38, 26:38] = 0.0  # enclosed 12^3 hollow cavity
+
+        occ32_unpruned, info_unpruned = Trellis2ImageTo3DPipeline._exterior_prune_and_score(
+            occ > 0.5, resolution=32, prune=False
+        )
+        occ32_pruned, info_pruned = Trellis2ImageTo3DPipeline._exterior_prune_and_score(
+            occ > 0.5, resolution=32, prune=True
+        )
+        self.assertEqual(info_unpruned["cavity_voxels64"], 12**3)
+        self.assertLess(info_pruned["n_tokens"], info_unpruned["n_tokens"])
+        self.assertEqual(info_pruned["n_components"], 1)
+
