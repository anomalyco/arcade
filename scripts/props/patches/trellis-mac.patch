@@ -0,0 +1,517 @@
+#!/usr/bin/env python3
+"""
+Resident TRELLIS.2 worker for Apple Silicon (MPS + Metal).
+
+Keeps the 8 active 512-pipeline models (~10.9 GB) warm in unified memory,
+processes a FIFO queue of image-to-3D jobs over a Unix domain socket, and
+automatically unloads itself after --idle-timeout seconds (default 300s = 5 min)
+so the Mac Studio's 36 GB RAM is freed for builds, browsers, and games.
+
+Jobs must still be invoked through hivemind, one at a time:
+  hivemind run --kind render --worker studio -- \\
+    ~/code/experiments/image-to-3d/trellis2-mac/.venv/bin/python \\
+    ~/code/experiments/image-to-3d/trellis2-mac/trellis_worker.py run ...
+"""
+
+import argparse
+import gc
+import json
+import os
+import queue
+import socket
+import subprocess
+import sys
+import threading
+import time
+import traceback
+
+TRELLIS_HOME = os.path.dirname(os.path.abspath(__file__))
+DEFAULT_TMP = "/private/var/folders/4t/_jnrck017r5f_jttbc19b7s40000gn/T/opencode"
+if not os.path.isdir(DEFAULT_TMP):
+    DEFAULT_TMP = os.path.expanduser("~/.cache")
+os.makedirs(DEFAULT_TMP, exist_ok=True)
+DEFAULT_SOCKET = os.environ.get("TRELLIS2_WORKER_SOCKET", os.path.join(DEFAULT_TMP, "trellis2-worker.sock"))
+DEFAULT_LOG = os.environ.get("TRELLIS2_WORKER_LOG", os.path.join(DEFAULT_TMP, "trellis2-worker.log"))
+DEFAULT_IDLE_TIMEOUT = int(os.environ.get("TRELLIS2_IDLE_TIMEOUT", "300"))
+
+
+def _setup_env():
+    os.environ.setdefault("PYTORCH_ENABLE_MPS_FALLBACK", "1")
+    os.environ.setdefault("ATTN_BACKEND", "sdpa")
+    os.environ.setdefault("SPARSE_ATTN_BACKEND", "sdpa")
+    try:
+        import flex_gemm  # noqa: F401
+        os.environ.setdefault("SPARSE_CONV_BACKEND", "flex_gemm")
+    except (ImportError, RuntimeError):
+        os.environ.setdefault("SPARSE_CONV_BACKEND", "none")
+    if os.path.join(TRELLIS_HOME, "TRELLIS.2") not in sys.path:
+        sys.path.insert(0, os.path.join(TRELLIS_HOME, "TRELLIS.2"))
+    if TRELLIS_HOME not in sys.path:
+        sys.path.insert(0, TRELLIS_HOME)
+    stubs = os.path.join(TRELLIS_HOME, "stubs")
+    if stubs not in sys.path:
+        sys.path.append(stubs)
+
+
+class TrellisResidentServer:
+    def __init__(self, socket_path: str = DEFAULT_SOCKET, idle_timeout: int = DEFAULT_IDLE_TIMEOUT, on_exit=None):
+        self.socket_path = socket_path
+        self.idle_timeout = idle_timeout
+        self.pipeline = None
+        self.initial_load_s = 0.0
+        self.jobs_completed = 0
+        self.last_active = time.time()
+        self.busy = False
+        self.pending_jobs = 0
+        self.stop_requested = False
+        self._lock = threading.Lock()
+        self._exited = threading.Event()
+        self._server_sock: socket.socket | None = None
+        self._on_exit = on_exit or (lambda: os._exit(0))
+        self.job_queue: "queue.Queue[tuple[dict, queue.Queue]]" = queue.Queue()
+
+    def load_pipeline(self):
+        if self.pipeline is not None:
+            return
+        _setup_env()
+        import torch
+        from trellis2.pipelines.trellis2_image_to_3d import Trellis2ImageTo3DPipeline
+
+        t0 = time.perf_counter()
+        self.pipeline = Trellis2ImageTo3DPipeline.from_pretrained("microsoft/TRELLIS.2-4B")
+        self.pipeline.to(torch.device("mps"))
+        if torch.backends.mps.is_available():
+            torch.mps.synchronize()
+        self.initial_load_s = round(time.perf_counter() - t0, 2)
+        with self._lock:
+            self.last_active = time.time()
+        print(f"[trellis-worker] pipeline loaded on MPS in {self.initial_load_s:.2f}s (pid={os.getpid()}, idle_timeout={self.idle_timeout}s)", flush=True)
+
+    def unload_and_exit(self, reason: str):
+        with self._lock:
+            self.stop_requested = True
+            srv = self._server_sock
+            self._server_sock = None
+        print(f"[trellis-worker] shutting down ({reason})", flush=True)
+        try:
+            if self.socket_path and os.path.exists(self.socket_path):
+                os.unlink(self.socket_path)
+        except OSError:
+            pass
+        try:
+            import torch
+            self.pipeline = None
+            gc.collect()
+            if torch.backends.mps.is_available():
+                torch.mps.empty_cache()
+        except Exception:
+            pass
+        if srv is not None:
+            try:
+                srv.close()
+            except OSError:
+                pass
+        try:
+            self._on_exit()
+        finally:
+            self._exited.set()
+
+    def _prepare_cutout(self, job: dict):
+        import numpy as np
+        from PIL import Image
+
+        image_path = job["image_path"]
+        cutout_path = job.get("cutout_path")
+        reuse_cutout = job.get("reuse_cutout", True)
+
+        if reuse_cutout and cutout_path and os.path.exists(cutout_path):
+            img = Image.open(cutout_path).convert("RGBA")
+            return img, 0.0, "cached_cutout"
+
+        src = Image.open(image_path)
+        if src.mode == "RGBA":
+            arr = np.array(src)
+            if arr[:, :, 3].min() < 255 and os.environ.get("TRELLIS2_SKIP_REMBG_WHEN_ALPHA", "1") == "1":
+                if cutout_path:
+                    src.save(cutout_path)
+                return src, 0.0, "source_alpha"
+
+        rgb = src.convert("RGB")
+        rgba = np.array(self.pipeline.rembg_model(rgb))
+        rgba[:, :, 3] = np.where(rgba[:, :, 3] > 200, 255, 0).astype(np.uint8)
+        out = Image.fromarray(rgba, "RGBA")
+        if cutout_path:
+            out.save(cutout_path)
+        return out, None, "birefnet"
+
+    def _execute_job(self, job: dict) -> dict:
+        import numpy as np
+        import torch
+        import fast_simplification
+        import o_voxel.postprocess
+
+        # Apply any per-job env overrides (for Stage 1A vs 1B benchmarking)
+        env_overrides = job.get("env", {})
+        prev_env = {}
+        for k, v in env_overrides.items():
+            prev_env[k] = os.environ.get(k)
+            os.environ[k] = str(v)
+
+        try:
+            t_start = time.perf_counter()
+            load_s = self.initial_load_s if self.jobs_completed == 0 and job.get("report_cold_load", False) else 0.0
+
+            t_c0 = time.perf_counter()
+            img, cut_override, cut_source = self._prepare_cutout(job)
+            if torch.backends.mps.is_available():
+                torch.mps.synchronize()
+            t_cut = round(time.perf_counter() - t_c0, 3) if cut_override is None else cut_override
+
+            seed = int(job.get("seed", 42))
+            faces_target = int(job.get("faces", 40000))
+            tex_size = int(job.get("texture", 2048))
+            bake_texture = job.get("bake_texture", None)
+            fast_sampler = job.get("fast_sampler", None)
+            fill_interior = job.get("fill_interior_voxels", None)
+            num_shape_seeds = job.get("num_shape_seeds", None)
+
+            t_g0 = time.perf_counter()
+            out = self.pipeline.run(
+                img,
+                seed=seed,
+                pipeline_type="512",
+                fast_sampler=fast_sampler,
+                fill_interior_voxels=fill_interior,
+                num_shape_seeds=num_shape_seeds,
+            )
+            mesh = out[0] if isinstance(out, list) else out
+            if torch.backends.mps.is_available():
+                torch.mps.synchronize()
+            t_gen = round(time.perf_counter() - t_g0, 3)
+
+            v = mesh.vertices.cpu().numpy()
+            f = mesh.faces.cpu().numpy()
+            raw_tris = int(len(f))
+            if v.shape[0] == 0 or raw_tris == 0:
+                return {"ok": False, "error": "empty mesh", "id": job.get("id")}
+
+            t_b0 = time.perf_counter()
+            target = min(200000, raw_tris)
+            if raw_tris > target:
+                sv, sf = fast_simplification.simplify(v, f, 1.0 - target / raw_tris)
+                vt = torch.from_numpy(sv).float()
+                ft = torch.from_numpy(sf.astype("int32"))
+            else:
+                vt = mesh.vertices.cpu().float()
+                ft = mesh.faces.cpu().int()
+
+            attrs_cpu = mesh.attrs.cpu()
+            coords_cpu = mesh.coords.cpu()
+            glb = o_voxel.postprocess.to_glb(
+                vertices=vt,
+                faces=ft,
+                attr_volume=attrs_cpu,
+                coords=coords_cpu,
+                attr_layout=mesh.layout,
+                voxel_size=mesh.voxel_size,
+                aabb=[[-0.5, -0.5, -0.5], [0.5, 0.5, 0.5]],
+                decimation_target=faces_target,
+                texture_size=tex_size,
+                bake_texture=bake_texture,
+                verbose=False,
+            )
+            out_glb = job["out_glb"]
+            os.makedirs(os.path.dirname(os.path.abspath(out_glb)), exist_ok=True)
+            glb.export(out_glb)
+
+            out_ovoxel = job.get("out_ovoxel")
+            if out_ovoxel:
+                np.savez(
+                    out_ovoxel,
+                    coords=coords_cpu.numpy().astype(np.uint16),
+                    attrs=np.clip(np.round(attrs_cpu.numpy() * 255.0), 0, 255).astype(np.uint8),
+                    voxel_size=np.float32(mesh.voxel_size),
+                )
+
+            t_bake = round(time.perf_counter() - t_b0, 3)
+            total_s = round(time.perf_counter() - t_start, 3)
+            if torch.backends.mps.is_available():
+                torch.mps.empty_cache()
+
+            self.jobs_completed += 1
+            stage_t = dict(getattr(self.pipeline, "last_stage_timings", None) or {})
+            rec = {
+                "ok": True,
+                "id": job.get("id", os.path.basename(out_glb)),
+                "load_s": round(load_s, 2),
+                "cutout_s": round(t_cut, 2),
+                "cutout_source": cut_source,
+                "generate_s": round(t_gen, 2),
+                "bake_s": round(t_bake, 2),
+                "total_s": round(total_s, 2),
+                "raw_tris": raw_tris,
+                "out_tris": int(len(glb.faces)),
+                "stages": stage_t,
+                "shape_seed_info": getattr(self.pipeline, "last_shape_seed_info", None),
+                "at": time.strftime("%Y-%m-%dT%H:%M:%S"),
+            }
+            print(f"[trellis-worker] finished {rec['id']} in {rec['total_s']}s (gen {rec['generate_s']}s, bake {rec['bake_s']}s)", flush=True)
+            return rec
+        finally:
+            for k, old_v in prev_env.items():
+                if old_v is None:
+                    os.environ.pop(k, None)
+                else:
+                    os.environ[k] = old_v
+
+    execute_job = _execute_job
+
+    def _worker_loop(self):
+        while not self.stop_requested:
+            try:
+                job, reply_q = self.job_queue.get(timeout=0.5)
+            except queue.Empty:
+                continue
+            with self._lock:
+                self.busy = True
+                self.last_active = time.time()
+            try:
+                res = self._execute_job(job)
+            except Exception as e:
+                traceback.print_exc()
+                res = {"ok": False, "error": str(e), "id": job.get("id")}
+            finally:
+                with self._lock:
+                    self.last_active = time.time()
+                    self.busy = False
+                    self.pending_jobs = max(0, self.pending_jobs - 1)
+                self.job_queue.task_done()
+            reply_q.put(res)
+
+    def _idle_watchdog(self):
+        poll_s = min(2.0, max(0.05, self.idle_timeout / 4.0))
+        while not self.stop_requested:
+            time.sleep(poll_s)
+            reason = None
+            with self._lock:
+                if not self.stop_requested and not self.busy and self.pending_jobs == 0:
+                    idle_s = time.time() - self.last_active
+                    if idle_s >= self.idle_timeout:
+                        self.stop_requested = True
+                        reason = f"idle for {idle_s:.1f}s >= {self.idle_timeout}s"
+            if reason is not None:
+                self.unload_and_exit(reason)
+                return
+
+    def _handle_client(self, conn: socket.socket):
+        try:
+            data = b""
+            while not data.endswith(b"\n"):
+                chunk = conn.recv(65536)
+                if not chunk:
+                    break
+                data += chunk
+            if not data:
+                return
+            req = json.loads(data.decode("utf-8"))
+            cmd = req.get("cmd", "job")
+            if cmd == "ping":
+                with self._lock:
+                    busy = self.busy
+                    queued = max(0, self.pending_jobs - (1 if busy else 0))
+                    idle_s = round(time.time() - self.last_active, 1)
+                resp = {
+                    "ok": True,
+                    "pid": os.getpid(),
+                    "busy": busy,
+                    "queued": queued,
+                    "idle_s": idle_s,
+                    "idle_timeout": self.idle_timeout,
+                    "initial_load_s": self.initial_load_s,
+                    "jobs_completed": self.jobs_completed,
+                }
+                conn.sendall((json.dumps(resp) + "\n").encode("utf-8"))
+            elif cmd == "stop":
+                resp = {"ok": True, "stopped": True, "pid": os.getpid()}
+                conn.sendall((json.dumps(resp) + "\n").encode("utf-8"))
+                conn.close()
+                self.unload_and_exit("explicit stop command")
+            elif cmd == "job":
+                reply_q: "queue.Queue[dict]" = queue.Queue(maxsize=1)
+                with self._lock:
+                    if self.stop_requested:
+                        conn.sendall((json.dumps({"ok": False, "error": "worker is stopping", "id": req.get("id")}) + "\n").encode("utf-8"))
+                        return
+                    self.pending_jobs += 1
+                    self.last_active = time.time()
+                self.job_queue.put((req, reply_q))
+                resp = reply_q.get()
+                conn.sendall((json.dumps(resp) + "\n").encode("utf-8"))
+            else:
+                conn.sendall((json.dumps({"ok": False, "error": f"unknown cmd: {cmd}"}) + "\n").encode("utf-8"))
+        except Exception as e:
+            try:
+                conn.sendall((json.dumps({"ok": False, "error": str(e)}) + "\n").encode("utf-8"))
+            except Exception:
+                pass
+        finally:
+            try:
+                conn.close()
+            except Exception:
+                pass
+
+    def serve_forever(self):
+        if os.path.exists(self.socket_path):
+            try:
+                os.unlink(self.socket_path)
+            except OSError:
+                pass
+        self.load_pipeline()
+        threading.Thread(target=self._worker_loop, daemon=True).start()
+        threading.Thread(target=self._idle_watchdog, daemon=True).start()
+
+        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        self._server_sock = srv
+        srv.bind(self.socket_path)
+        srv.listen(32)
+        print(f"[trellis-worker] listening on {self.socket_path}", flush=True)
+        while not self.stop_requested:
+            try:
+                conn, _ = srv.accept()
+                threading.Thread(target=self._handle_client, args=(conn,), daemon=True).start()
+            except Exception:
+                if self.stop_requested:
+                    break
+        self._exited.wait(timeout=5.0)
+
+
+def send_request(req: dict, socket_path: str = DEFAULT_SOCKET, timeout: float = 900.0) -> dict:
+    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    s.settimeout(timeout)
+    s.connect(socket_path)
+    try:
+        s.sendall((json.dumps(req) + "\n").encode("utf-8"))
+        buf = b""
+        while not buf.endswith(b"\n"):
+            chunk = s.recv(65536)
+            if not chunk:
+                break
+            buf += chunk
+        return json.loads(buf.decode("utf-8"))
+    finally:
+        s.close()
+
+
+def ping_worker(socket_path: str = DEFAULT_SOCKET) -> dict | None:
+    if not os.path.exists(socket_path):
+        return None
+    try:
+        return send_request({"cmd": "ping"}, socket_path=socket_path, timeout=3.0)
+    except Exception:
+        return None
+
+
+def ensure_worker(socket_path: str = DEFAULT_SOCKET, idle_timeout: int = DEFAULT_IDLE_TIMEOUT, log_path: str = DEFAULT_LOG) -> tuple[dict, bool]:
+    """Return (ping_info, started_cold). Spawns the background daemon if not already running."""
+    info = ping_worker(socket_path)
+    if info and info.get("ok"):
+        return info, False
+
+    cmd = [
+        sys.executable,
+        os.path.abspath(__file__),
+        "serve",
+        "--socket",
+        socket_path,
+        "--idle-timeout",
+        str(idle_timeout),
+    ]
+    with open(log_path, "a") as log_f:
+        proc = subprocess.Popen(
+            cmd,
+            stdout=log_f,
+            stderr=log_f,
+            stdin=subprocess.DEVNULL,
+            start_new_session=True,
+        )
+    t0 = time.time()
+    while time.time() - t0 < 180.0:
+        time.sleep(0.5)
+        info = ping_worker(socket_path)
+        if info and info.get("ok"):
+            return info, True
+        if proc.poll() is not None:
+            raise RuntimeError(f"trellis_worker exited prematurely with code {proc.returncode} (see {log_path})")
+    raise RuntimeError(f"Timed out waiting for trellis_worker to start (see {log_path})")
+
+
+def main():
+    sub_common = argparse.ArgumentParser(add_help=False)
+    sub_common.add_argument("--socket", default=argparse.SUPPRESS)
+    sub_common.add_argument("--idle-timeout", type=int, default=argparse.SUPPRESS)
+
+    parser = argparse.ArgumentParser(description="Resident TRELLIS.2 worker on Apple Silicon")
+    parser.add_argument("--socket", default=DEFAULT_SOCKET)
+    parser.add_argument("--idle-timeout", type=int, default=DEFAULT_IDLE_TIMEOUT)
+    sub = parser.add_subparsers(dest="subcmd", required=True)
+
+    sub.add_parser("serve", help="Run the resident worker daemon", parents=[sub_common])
+    sub.add_parser("status", help="Check resident worker status", parents=[sub_common])
+    sub.add_parser("stop", help="Stop resident worker and unload weights", parents=[sub_common])
+
+    p_run = sub.add_parser("run", help="Submit a job to the resident worker (starts it if needed)", parents=[sub_common])
+    p_run.add_argument("--id", required=True)
+    p_run.add_argument("--image", required=True)
+    p_run.add_argument("--cutout", default="")
+    p_run.add_argument("--out-glb", required=True)
+    p_run.add_argument("--out-ovoxel", default="")
+    p_run.add_argument("--seed", type=int, default=42)
+    p_run.add_argument("--faces", type=int, default=40000)
+    p_run.add_argument("--texture", type=int, default=2048)
+    p_run.add_argument("--vertex-color-only", action="store_true")
+    p_run.add_argument("--with-texture", action="store_true")
+    p_run.add_argument("--fast-sampler", action="store_true")
+    p_run.add_argument("--fill-interior", action="store_true")
+    p_run.add_argument("--shape-seeds", type=int, default=1)
+
+    args = parser.parse_args()
+    if args.subcmd == "serve":
+        srv = TrellisResidentServer(socket_path=args.socket, idle_timeout=args.idle_timeout)
+        srv.serve_forever()
+    elif args.subcmd == "status":
+        info = ping_worker(args.socket)
+        print(json.dumps(info or {"ok": False, "running": False}))
+    elif args.subcmd == "stop":
+        info = ping_worker(args.socket)
+        if not info:
+            print(json.dumps({"ok": True, "already_stopped": True}))
+        else:
+            print(json.dumps(send_request({"cmd": "stop"}, socket_path=args.socket, timeout=10.0)))
+    elif args.subcmd == "run":
+        info, cold = ensure_worker(socket_path=args.socket, idle_timeout=args.idle_timeout)
+        res = send_request(
+            {
+                "cmd": "job",
+                "id": args.id,
+                "image_path": args.image,
+                "cutout_path": args.cutout or None,
+                "out_glb": args.out_glb,
+                "out_ovoxel": args.out_ovoxel or None,
+                "seed": args.seed,
+                "faces": args.faces,
+                "texture": args.texture,
+                "bake_texture": bool(args.with_texture or not args.vertex_color_only),
+                "fast_sampler": args.fast_sampler,
+                "fill_interior_voxels": args.fill_interior,
+                "num_shape_seeds": args.shape_seeds,
+                "report_cold_load": cold,
+            },
+            socket_path=args.socket,
+        )
+        print(json.dumps(res))
+        if not res.get("ok"):
+            sys.exit(1)
+
+
+if __name__ == "__main__":
+    main()
