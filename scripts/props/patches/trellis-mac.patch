+class TestMeshExtractEquivalence(unittest.TestCase):
+    def test_fast_lookup_matches_dict_fallback_bit_exact(self):
+        coords = torch.tensor(
+            [
+                [1, 1, 1],
+                [1, 1, 2],
+                [1, 2, 1],
+                [1, 2, 2],
+                [2, 1, 1],
+                [2, 1, 2],
+                [2, 2, 1],
+                [2, 2, 2],
+            ],
+            dtype=torch.int32,
+        )
+        torch.manual_seed(7)
+        dual_vertices = torch.rand((coords.shape[0], 3), dtype=torch.float32) * 0.6 + 0.2
+        intersected = torch.zeros((coords.shape[0], 3), dtype=torch.bool)
+        intersected[0] = torch.tensor([True, True, True])
+        aabb = [[-0.5, -0.5, -0.5], [0.5, 0.5, 0.5]]
+
+        prev = os.environ.get("TRELLIS2_FAST_MESH_EXTRACT")
+        try:
+            os.environ["TRELLIS2_FAST_MESH_EXTRACT"] = "0"
+            v_slow, f_slow = flexible_dual_grid_to_mesh(
+                coords, dual_vertices, intersected, None, aabb, grid_size=8
+            )
+            os.environ["TRELLIS2_FAST_MESH_EXTRACT"] = "1"
+            v_fast, f_fast = flexible_dual_grid_to_mesh(
+                coords, dual_vertices, intersected, None, aabb, grid_size=8
+            )
+        finally:
+            if prev is None:
+                os.environ.pop("TRELLIS2_FAST_MESH_EXTRACT", None)
+            else:
+                os.environ["TRELLIS2_FAST_MESH_EXTRACT"] = prev
+
+        self.assertTrue(torch.equal(v_slow, v_fast))
+        self.assertTrue(torch.equal(f_slow, f_fast))
+        self.assertEqual(f_fast.shape, (6, 3))
+
