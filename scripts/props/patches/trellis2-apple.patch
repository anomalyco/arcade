+def _sample_surface_attrs(query_pos, vertices, faces, bvh, attr_volume, coords, grid_size, aabb, voxel_size):
+    """Project query_pos onto the original high-res mesh via BVH and trilinearly sample attr_volume."""
+    _, face_id, uvw = bvh.unsigned_distance(query_pos, return_uvw=True)
+    orig_tri_verts = vertices[faces[face_id.long()]]
+    valid_pos = (orig_tri_verts * uvw.unsqueeze(-1)).sum(dim=1)
+    return _grid_sample_3d(
+        attr_volume,
+        torch.cat([torch.zeros_like(coords[:, :1]), coords], dim=-1),
+        shape=torch.Size([1, attr_volume.shape[1], *grid_size.tolist()]),
+        grid=((valid_pos - aabb[0]) / voxel_size).reshape(1, -1, 3),
+        mode='trilinear',
+    ).reshape(-1, attr_volume.shape[1])
+
+
+def _finalize_zup_mesh(out_vertices, out_faces, out_normals):
+    """Convert Y-up tensors to Z-up numpy arrays and repair inward-flipped connected components."""
+    vertices_np = out_vertices.cpu().numpy()
+    faces_np = out_faces.cpu().numpy()
+    normals_np = out_normals.cpu().numpy()
+    vertices_np[:, 1], vertices_np[:, 2] = vertices_np[:, 2].copy(), -vertices_np[:, 1].copy()
+    normals_np[:, 1], normals_np[:, 2] = normals_np[:, 2].copy(), -normals_np[:, 1].copy()
+    try:
+        from scipy.spatial import cKDTree
+        g_merged = trimesh.Trimesh(vertices=vertices_np, faces=faces_np, process=True)
+        comps = trimesh.graph.connected_components(g_merged.face_adjacency, nodes=np.arange(len(faces_np)))
+        center_all = (vertices_np.min(axis=0) + vertices_np.max(axis=0)) * 0.5
+        fn_geom = g_merged.face_normals
+        fc = vertices_np[faces_np].mean(axis=1) - center_all
+        for comp in comps:
+            if (fn_geom[comp] * fc[comp]).sum() < 0:
+                faces_np[comp] = faces_np[comp][:, [0, 2, 1]]
+        g_merged2 = trimesh.Trimesh(vertices=vertices_np, faces=faces_np, process=True)
+        tree = cKDTree(g_merged2.vertices)
+        _, idx = tree.query(vertices_np)
+        normals_np = g_merged2.vertex_normals[idx]
+    except Exception:
+        pass
+    return vertices_np, faces_np, normals_np
 
 
