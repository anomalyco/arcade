{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "types": ["bun", "@webgpu/types"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "incremental": true,
    "tsBuildInfoFile": "../node_modules/.cache/tsc/scripts.tsbuildinfo"
  },
  "include": [
    "**/*.ts",
    "../games/blackout/scripts/animation/**/*.ts",
    "../games/blackout/tests/motion-*.test.ts",
    "../packages/kit/server/workers-shim.d.ts"
  ]
}
